{
  "expo": {
    "name": "GymVision",
    "slug": "gymvision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.uclm.gymvision",
      "infoPlist": {
        "NSMotionUsageDescription": "GymVision usa el acelerómetro para contar tus pasos en cardio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "es.uclm.gymvision",
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "GymVision usa la cámara para leer el QR de las máquinas."
        }
      ],
      "expo-notifications",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "GymVision usa NFC para abrir tu taquilla al acercar el móvil a la cerradura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GymVision usa tus fotos solo para tu foto de perfil, que se guarda en el móvil."
        }
      ]
    ],
    "scheme": "gymvision",
    "newArchEnabled": true
  }
}
